  {
    "name": "a continuation extends a saved message",
    "message": {
      "id": "op:reply",
      "role": "assistant",
      "parts": [
        {
          "type": "text",
          "text": "Let me check."
        },
        {
          "type": "tool",
          "toolCallId": "c1",
          "toolName": "delete",
          "state": "approval-requested",
          "input": {
            "id": 3
          },
