            "id": "c1"
          }
        }
      ]
    },
    "chunks": [
      {
        "type": "tool-output-available",
        "toolCallId": "c1",
        "output": "deleted"
      },
      {
        "type": "text-start",
        "id": "1:0"
      },
      {
        "type": "text-delta",
        "id": "1:0",
        "delta": "Done."
      },
      {
        "type": "text-end",
        "id": "1:0"
      }
    ],
    "expected": {
      "id": "op:reply",
      "role": "assistant",
      "parts": [
        {
          "type": "text",
          "text": "Let me check."
        },
        {
          "type": "tool",
          "toolCallId": "c1",
          "toolName": "delete",
          "state": "output-available",
          "input": {
            "id": 3
          },
          "approval": {
            "id": "c1"
          },
          "output": "deleted"
        },
        {
          "type": "text",
          "text": "Done."
        }
      ]
    }
  }
