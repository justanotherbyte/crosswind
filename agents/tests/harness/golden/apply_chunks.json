[
  {
    "name": "provider metadata from a part's start and end (upstream apply-chunks.test.ts)",
    "message": {
      "id": "m1",
      "role": "assistant",
      "parts": []
    },
    "chunks": [
      {
        "type": "reasoning-start",
        "id": "r",
        "providerMetadata": {
          "a": 1
        }
      },
      {
        "type": "reasoning-delta",
        "id": "r",
        "delta": "thinking"
      },
      {
        "type": "reasoning-end",
        "id": "r",
        "providerMetadata": {
          "b": 2
        }
      },
      {
        "type": "text-start",
        "id": "t"
      },
      {
        "type": "text-delta",
        "id": "t",
        "delta": "Hi"
      },
      {
        "type": "text-end",
        "id": "t"
      }
    ],
    "expected": {
      "id": "m1",
      "role": "assistant",
      "parts": [
        {
          "type": "reasoning",
          "text": "thinking",
          "providerMetadata": {
            "a": 1,
            "b": 2
          }
        },
        {
          "type": "text",
          "text": "Hi"
        }
      ]
    }
  },
