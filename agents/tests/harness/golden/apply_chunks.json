  {
    "name": "a tool call streams, runs, and returns",
    "message": {
      "id": "m",
      "role": "assistant",
      "parts": []
    },
    "chunks": [
      {
        "type": "tool-input-start",
        "toolCallId": "c1",
        "toolName": "search",
        "title": "Search"
      },
      {
        "type": "tool-input-delta",
        "toolCallId": "c1",
        "delta": "{\"q\":"
      },
      {
        "type": "tool-input-delta",
        "toolCallId": "c1",
        "delta": "\"x\"}"
      },
      {
        "type": "tool-input-available",
        "toolCallId": "c1",
        "toolName": "search",
        "input": {
          "q": "x"
        },
        "providerMetadata": {
          "p": {
            "k": 1
          }
        }
      },
      {
        "type": "tool-output-available",
        "toolCallId": "c1",
        "output": [
          "x"
        ]
      }
    ],
    "expected": {
      "id": "m",
      "role": "assistant",
      "parts": [
        {
          "toolCallId": "c1",
          "toolName": "search",
          "title": "Search",
          "type": "tool",
          "state": "output-available",
          "input": {
            "q": "x"
          },
          "providerMetadata": {
            "p": {
              "k": 1
            }
          },
          "output": [
            "x"
          ]
        }
      ]
    }
  },
